# Copy to .env (git-ignored, never committed) and fill in. Both are unused until step 3 (scripts/seed).
# URL of the dev Home Assistant that scripts talk to (scripts/develop serves it on localhost:8123).
HA_FITNESS_DEV_HA_URL=http://localhost:8123
# A long-lived access token for that dev Home Assistant (profile > Security). Never a real HA's token.
HA_FITNESS_DEV_HA_TOKEN=
